{
  "name": "ai-receptionist-backend",
  "version": "1.0.0",
  "description": "Express API for the AI receptionist booking platform",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon --legacy-watch --watch index.js --watch middleware --watch routes --watch services --watch validation --watch platform --watch booking index.js",
    "db:migrate": "node scripts/migrate.js",
    "db:status": "node scripts/migrate.js --status",
    "db:review": "node scripts/migrate.js --report",
    "business:grant": "node scripts/grantMembership.js",
    "demo:seed": "node scripts/seedDemo.js",
    "test": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand --silent",
    "test:unit": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand --silent --testPathIgnorePatterns integration",
    "test:integration": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand --silent tests/integration"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^8.3.1",
    "googleapis": "^171.4.0",
    "groq-sdk": "^0.37.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.13",
    "pg": "^8.11.5",
    "twilio": "^5.3.4",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0",
    "jest": "^29.7.0"
  }
}
