# Copy to backend/.env (backend) and frontend/.env (frontend) and fill in real values.
# Never commit real values.

# ── Backend ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
PORT=4000
FRONTEND_URL=http://localhost:3000
TRUST_PROXY=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Signs staff login tokens and guest session tokens. Long and random.
SESSION_SIGNING_SECRET=change-me-to-a-long-random-string
# Encrypts integration credentials at rest (32+ characters). Required before adding any integration.
INTEGRATION_ENCRYPTION_KEY=change-me-to-another-long-random-string

# LLM
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional: the business guests reach when the booking link has no ?business=…
# (not needed while exactly one business is active)
DEFAULT_BUSINESS_SLUG=

# ── Migrating an existing (pre-platform) database ────────────────────────────
# Only read by `npm run db:migrate` when old single-business data is present.
LEGACY_BUSINESS_TIMEZONE=Asia/Bangkok   # REQUIRED in that case: how existing dates/times are interpreted
LEGACY_BUSINESS_CURRENCY=               # optional; if empty an owner must confirm the currency before activation
LEGACY_BUSINESS_NAME=
LEGACY_BUSINESS_SLUG=

# ── Google Calendar (downstream display only) ────────────────────────────────
# One service account for the deployment. Each business sets its own calendar ID
# in Settings; GOOGLE_CALENDAR_ID is inherited only by the migrated legacy business.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
CALENDAR_TIMEZONE=Asia/Bangkok

# ── Notifications (optional) ─────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Env fallbacks below apply to the legacy business only; other businesses use Settings.
STAFF_ALERT_EMAIL=
STAFF_WEBHOOK_URL=
STAFF_WEBHOOK_PROVIDER=slack

# ── Background jobs ──────────────────────────────────────────────────────────
RECONCILE_INTERVAL_SECONDS=300
DISABLE_JOB_WORKER=false

# ── Development only ─────────────────────────────────────────────────────────
# Lets guests book a service connected to the MOCK provider. Ignored when NODE_ENV=production.
ALLOW_MOCK_PROVIDER_BOOKING=false
# Tests use this database (its name must contain "test"); never your real one.
TEST_DATABASE_URL=postgres://localhost:5432/ai_receptionist_test

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DEFAULT_BUSINESS_SLUG=
NEXT_PUBLIC_ENABLE_LOCALSTORAGE_AUTH_FALLBACK=true
